{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "moessimple/tinkerbench",
    "type": "project",
    "description": "A browser based PHP REPL for any project linked in Laravel Herd.",
    "keywords": [
        "laravel",
        "herd",
        "tinker",
        "repl",
        "php"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.3.2",
        "laravel/framework": "^13.30.1",
        "laravel/lsp": "^0.0.31",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "nunomaduro/essentials": "^1.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.11",
        "laravel/boost": "^2.7.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.1.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.6.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "/vendor/laravel/lsp/app/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "composer install --working-dir=packages/runner",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build",
            "herd link tinkerbench --secure",
            "herd isolate 8.5"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "composer lint --working-dir=packages/runner",
            "npm run lint"
        ],
        "test:type-coverage": [
            "php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "npm run test:lint"
        ],
        "test:unit": [
            "sh -c 'pest=\"vendor/bin/pest --parallel --coverage --exactly=100.0\"; command -v herd >/dev/null 2>&1 && herd coverage $pest || XDEBUG_MODE=coverage $pest'",
            "npm run test:unit"
        ],
        "test:types": [
            "phpstan analyse --memory-limit=512M",
            "npm run test:types"
        ],
        "test:runner": [
            "composer test --working-dir=packages/runner"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:runner"
        ],
        "update:dependencies": [
            "@composer update --bump-after-update",
            "npm update --save"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {},
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "autoloader-suffix": "TinkerbenchInternal"
    },
    "minimum-stability": "stable"
}
