{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "moessimple/tinkerbench",
    "type": "project",
    "description": "A browser based PHP REPL for any project linked in Laravel Herd.",
    "keywords": [
        "laravel",
        "herd",
        "tinker",
        "repl",
        "php"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "composer-plugin-api": ">=2.9.0",
        "inertiajs/inertia-laravel": "^3.6.0",
        "laravel/framework": "^13.39.0",
        "laravel/lsp": "^0.0.31",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.23",
        "nunomaduro/essentials": "^1.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.4",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-browser": "^5.2.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.3.0",
        "pestphp/pest-plugin-type-coverage": "^5.1.0",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "/vendor/laravel/lsp/app/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "composer install --working-dir=packages/runner",
            "composer build --working-dir=packages/runner",
            "composer install --working-dir=packages/runner/tests/fixtures/plain-composer-php",
            "composer install --working-dir=packages/runner/tests/fixtures/laravel-12",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npx playwright install chromium",
            "npm run build",
            "herd link tinkerbench",
            "herd isolate 8.5"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "composer build --working-dir=packages/runner",
            "@php artisan dev"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "composer lint --working-dir=packages/runner",
            "npm run lint"
        ],
        "test:vet": "vet -n",
        "test:composer": [
            "@composer validate --strict",
            "composer test:composer --working-dir=packages/runner"
        ],
        "test:audit": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=packages/runner",
            "npm run test:audit"
        ],
        "test:type-coverage": [
            "pest --type-coverage --min=100",
            "composer test:type-coverage --working-dir=packages/runner"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "composer test:lint --working-dir=packages/runner",
            "npm run test:lint"
        ],
        "test:unit": [
            "composer build --working-dir=packages/runner",
            "XDEBUG_MODE=coverage pest --parallel --coverage --exactly=100.0",
            "composer test:unit --working-dir=packages/runner",
            "npm run test:unit"
        ],
        "test:browser": [
            "npx playwright install chromium",
            "pest --testsuite=Browser --group=browser"
        ],
        "test:types": [
            "phpstan analyse",
            "composer test:types --working-dir=packages/runner",
            "npm run test:types"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@test:composer",
            "@test:vet",
            "@test:audit",
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit",
            "@test:browser"
        ],
        "update:dependencies": [
            "@composer update",
            "@composer bump",
            "@composer update --working-dir=packages/runner",
            "@composer bump --working-dir=packages/runner",
            "@composer update --working-dir=packages/runner/tests/fixtures/laravel-12",
            "composer build --working-dir=packages/runner",
            "npm update --save"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {},
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "laravel/vet": true
        },
        "autoloader-suffix": "TinkerbenchInternal",
        "audit": {
            "ignore-abandoned": [
                "symplify/rule-doc-generator-contracts"
            ]
        }
    },
    "minimum-stability": "stable"
}
