includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    bootstrapFiles:
        - tests/TestSupport/PHPStan/register-custom-expectations.php

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: max

    phpVersion: 80500

    tmpDir: /tmp/phpstan

services:
    -
        class: Tests\TestSupport\PHPStan\PestCustomExpectationMethodsExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
