{
    "name": "tinkerbench/fixture-plain-composer-php",
    "description": "Test fixture: a Composer PHP project with no framework, proving SnippetRunner's basic pipeline.",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "composer-plugin-api": ">=2.11.0"
    },
    "autoload": {
        "psr-4": {
            "PlainComposerPhp\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "policy": {
            "cooldown": {
                "period": "3 days"
            }
        }
    }
}
