{
    "name": "tinkerbench/fixture-laravel-12",
    "description": "Test fixture: a minimal real Laravel 12 app, proving the runner's documented Laravel floor.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "composer-plugin-api": ">=2.11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "policy": {
            "cooldown": {
                "period": "3 days"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
