{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=11.17.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp fmt resources/ && vp lint --fix",
        "test:audit": "npm audit",
        "test:lint": "vp fmt --check resources/ && vp lint",
        "test:unit": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.11.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^5.1.0",
        "concurrently": "^10.0.7",
        "fontaine": "^0.8.2",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.2.1",
        "playwright": "^1.65.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@^1.6.0",
        "vite-plus": "^1.6.0",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "intelephense": "^1.18.5",
        "monaco-editor": "^0.57.0",
        "sql-formatter": "^15.9.0",
        "vscode-ws-jsonrpc": "^4.0.3",
        "vue": "^3.5.45",
        "ws": "^8.23.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "protobufjs": "^8.6.6",
        "@opentelemetry/core": "^2.10.0",
        "dompurify": "^3.4.17",
        "basic-ftp": "^6.2.4",
        "html-to-text": "^10.0.1",
        "glob": "^14.0.3",
        "minimatch": "^11.0.3",
        "vite": "$vite",
        "vitest": "$vitest"
    }
}
