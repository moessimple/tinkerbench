{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp fmt resources/ && vp lint --fix",
        "test:audit": "npm audit",
        "test:lint": "vp fmt --check resources/ && vp lint",
        "test:unit": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.9.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "5.0.5",
        "concurrently": "^10.0.6",
        "fontaine": "^0.8.2",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.2.0",
        "playwright": "^1.64.1",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0",
        "vite-plus": "1.4.0",
        "vitest": "5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "intelephense": "^1.18.5",
        "monaco-editor": "^0.57.0",
        "sql-formatter": "^15.9.0",
        "vscode-ws-jsonrpc": "^3.5.0",
        "vue": "^3.5.44",
        "ws": "^8.22.0"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "concurrently": {
            "shell-quote": "^1.11.0"
        },
        "protobufjs": "^8.6.6",
        "@opentelemetry/core": "^2.10.0",
        "dompurify": "^3.4.16",
        "basic-ftp": "^6.2.2",
        "html-to-text": "^10.0.1",
        "vite": "$vite",
        "vitest": "$vitest"
    }
}
