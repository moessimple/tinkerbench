{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp fmt resources/ && vp lint --fix",
        "test:audit": "npm audit",
        "test:lint": "vp fmt --check resources/ && vp lint",
        "test:unit": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.1",
        "@vitest/coverage-v8": "^4.1.11",
        "fontaine": "^0.8.2",
        "jsdom": "^30.1.0",
        "playwright": "^1.63.0",
        "vite-plus": "0.3.1",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.1",
        "@inertiajs/vue3": "^3.7.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.5",
        "intelephense": "^1.18.5",
        "laravel-vite-plugin": "^3.2.0",
        "monaco-editor": "^0.56.0",
        "sql-formatter": "^15.8.2",
